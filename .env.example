# DeskRelay configuration reference. This file is not loaded automatically.
# Export variables in the shell or add them to your process supervisor.

# Runtime data remains local. Never point this at a directory inside the repository.
# DESKRELAY_DATA_DIR=$HOME/.deskrelay
# DESKRELAY_LANG=zh

# Mobile web port on the computer running DeskRelay.
DESKRELAY_MOBILE_PORT=4396

# Leave unset for LAN-only web mode. When configured, the Mac actively connects
# to the application relay; no local port is exposed or reverse-tunnelled.
# DESKRELAY_RELAY_URL=https://relay.example.com
# DESKRELAY_RELAY_DEVICE_ID=my-mac
# DESKRELAY_RELAY_DEVICE_TOKEN=replace-with-a-long-random-token

# Advanced: an explicit public web base URL managed by your own approved gateway.
# Normal internet deployment should use DESKRELAY_RELAY_URL instead.
# DESKRELAY_MOBILE_PUBLIC_URL=https://mobile.example.com

# Public relay server environment (configure on the server, not the Mac daemon).
# DESKRELAY_RELAY_HOST=127.0.0.1
# DESKRELAY_RELAY_PORT=14396
# DESKRELAY_RELAY_DEVICE_ID=my-mac
# DESKRELAY_RELAY_DEVICE_TOKEN=replace-with-the-same-random-token
# DESKRELAY_RELAY_TASK_LINK_STATE_FILE=/var/lib/deskrelay/relay-task-links.json

# Optional upload limits.
# WECHAT_MAX_IMAGE_MB=20
# WECHAT_MAX_FILE_MB=50
# WECHAT_MAX_VOICE_MB=20
# WECHAT_MAX_VIDEO_MB=100

# Optional runtime behavior.
# DESKRELAY_STRICT_APPROVAL=1
# DESKRELAY_THINKING_FORWARD=1
# DESKRELAY_REASONIX_OPEN_WEB=0
